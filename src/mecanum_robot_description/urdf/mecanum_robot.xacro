<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       xmlns:gz="http://gazebosim.org/schema"
       xmlns:ignition="http://gazebosim.org/schema"
       name="mecanum_robot">

  <!-- ═══════════════════════════════════════════════════════════
       PARAMETRELER
       ═══════════════════════════════════════════════════════════ -->

  <!-- Gövde boyutları (metre) -->
  <xacro:property name="body_length" value="1.0"/>
  <xacro:property name="body_width"  value="0.7"/>
  <xacro:property name="body_height" value="0.3"/>

  <!-- Teker boyutları -->
  <xacro:property name="wheel_radius" value="0.1625"/>
  <xacro:property name="wheel_width"  value="0.09"/>
  <xacro:property name="wheel_scale"  value="0.01"/>

  <!-- Teker offset'leri (gövde merkezine göre) -->
  <xacro:property name="wheel_offset_x" value="${body_length/2 - 0.10}"/>
  <xacro:property name="wheel_offset_y" value="${body_width/2 + wheel_width + 0.1}"/>

  <!-- Kütle -->
  <xacro:property name="body_mass"  value="20.0"/>
  <xacro:property name="wheel_mass" value="1.0"/>

  <!-- Gövde merkez yüksekliği (tekerlek üzerinde) -->
  <xacro:property name="body_z" value="${wheel_radius + body_height/2}"/>

  <!-- Mesh yolları -->
  <xacro:property name="wheel_mesh_left"  value="package://mecanum_robot_description/meshes/mecanum_wheel_left.stl"/>
  <xacro:property name="wheel_mesh_right" value="package://mecanum_robot_description/meshes/mecanum_wheel_right.stl"/>

  <!-- ═══════════════════════════════════════════════════════════
       BASE FOOTPRINT & BASE LINK
       ═══════════════════════════════════════════════════════════ -->

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia
        ixx="${(1.0/12.0) * body_mass * (body_height*body_height + body_width*body_width)}"
        iyy="${(1.0/12.0) * body_mass * (body_height*body_height + body_length*body_length)}"
        izz="${(1.0/12.0) * body_mass * (body_length*body_length + body_width*body_width)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.15 0.35 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- ═══════════════════════════════════════════════════════════
       MECANUM TEKER MACRO'SU
       ═══════════════════════════════════════════════════════════

       Mecanum tekerleklerin sürtünme yönü (fdir1):
         FL ve RR → (1, -1, 0)   (sol çapraz silindirler)
         FR ve RL → (1,  1, 0)   (sağ çapraz silindirler)

       Collision: Sphere (mesh-collision uyumsuzluğunu önler)
       Visual:    STL mesh (gerçekçi görünüm)
  -->

  <xacro:macro name="mecanum_wheel" params="name parent x y z mesh fdir_x fdir_y">
    <link name="${name}">
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyy="${(1.0/2.0)  * wheel_mass * wheel_radius*wheel_radius}"
          izz="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${mesh}" scale="${wheel_scale} ${wheel_scale} ${wheel_scale}"/>
        </geometry>
        <material name="dark_rubber">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${wheel_radius}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="50.0" velocity="20.0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- Gazebo sürtünme ayarları (mecanum davranışı için kritik)

         fdir1 = makaraların (roller) ekseni. Sürtünme bu eksen BOYUNCA
         yüksek (mu), buna DİK yönde ~sıfır (mu2): makara o yönde serbest
         yuvarlanır. Tekerin ürettiği kuvvet böylece fdir1 boyunca olur.

         ignition:expressed_in ZORUNLU; hem attribute adi hem de frame adi
         tam boyle olmalidir.
         SDF spec'inde <fdir1> düz bir vector3'tür ve "collision-fixed
         reference frame"de yorumlanır — yani SÜREKLİ DÖNEN teker link'inde.
         Frame'i sabitlemek icin Fortress'in dartsim eklentisi
         'ignition:expressed_in' attribute'unu okur ('gz:expressed_in'
         DEĞİL; o Garden ve sonrasının ismidir ve Fortress'te SESSİZCE
         yok sayılır). Attribute okunmazsa sürtünme yönü tekerlekle
         birlikte döner: ileri hareket hata simetrik olduğu için doğru
         görünür, YANA KAYMA bozulur (ölçüm: vy=+0.20 komutuna karşılık
         gerçekte 0.62 m ileri + 0.46 m yana, ~54° çapraz).
         FRAME ADI base_footprint OLMALI, base_link DEGIL: URDF->SDF
         donusumu fixed-joint child'larini parent'a katliyor, base_link SDF'de
         yalniz bir <frame> olarak kaliyor, gercek link (DART BodyNode) degil.
         dartsim frame'i BodyNode olarak arar; bulamayinca "not setting
         friction direction frame" deyip yine collision frame'ine duser.
         base_joint saf oteleme oldugu icin (rpy=0) fdir1 bilesenleri iki
         frame'de ayni; degisim yalnizca cozunurlugu duzeltir.
         Uretilen SDF'te dogrulandi (ign sdf -p). -->
    <gazebo reference="${name}">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 ignition:expressed_in="base_footprint">${fdir_x} ${fdir_y} 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <!-- ═══════════════════════════════════════════════════════════
       4 MECANUM TEKER INSTANTIATE
       ═══════════════════════════════════════════════════════════ -->

  <!-- Ön Sol (FL) -->
  <xacro:mecanum_wheel name="wheel_fl" parent="base_link"
    x="${wheel_offset_x}" y="${wheel_offset_y}" z="${wheel_radius}"
    mesh="${wheel_mesh_left}" fdir_x="0.70710678" fdir_y="-0.70710678"/>

  <!-- Ön Sağ (FR) -->
  <xacro:mecanum_wheel name="wheel_fr" parent="base_link"
    x="${wheel_offset_x}" y="-${wheel_offset_y}" z="${wheel_radius}"
    mesh="${wheel_mesh_right}" fdir_x="0.70710678" fdir_y="0.70710678"/>

  <!-- Arka Sol (RL) -->
  <xacro:mecanum_wheel name="wheel_rl" parent="base_link"
    x="-${wheel_offset_x}" y="${wheel_offset_y}" z="${wheel_radius}"
    mesh="${wheel_mesh_right}" fdir_x="0.70710678" fdir_y="0.70710678"/>

  <!-- Arka Sağ (RR) -->
  <xacro:mecanum_wheel name="wheel_rr" parent="base_link"
    x="-${wheel_offset_x}" y="-${wheel_offset_y}" z="${wheel_radius}"
    mesh="${wheel_mesh_left}" fdir_x="0.70710678" fdir_y="-0.70710678"/>

  <!-- ═══════════════════════════════════════════════════════════
       LIDAR SENSÖRÜ
       ═══════════════════════════════════════════════════════════ -->

  <xacro:property name="lidar_z" value="${body_z + body_height/2 + 0.02}"/>

  <link name="lidar_link">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="sensor_black">
        <color rgba="0.15 0.15 0.15 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════
       IMU (BNO055) — govde merkezine yakin, sabit joint
       ═══════════════════════════════════════════════════════════ -->

  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>

  <!-- Gercek BNO055 montaj pozu CAD/olcumle dogrulanmadi. -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
  </joint>

  <!-- Not: Bu dosya ros2_control ve surus plugin'i ICERMEZ. Teker joint'leri
       yalniz mecanum_control ros2_control xacro parcalari (sim_robot.xacro /
       real_robot.xacro) uzerinden ros2_control SystemInterface ile suruluyor.
       Gazebo'nun kendi MecanumDrive plugin'i KASITLI olarak kullanilmiyor
       (iki-sahipli TF/odom hatasi). -->

  <!-- SADECE test/metrik icin ground-truth odometry (Gazebo model pozu).
       Nav2/EKF bu veriyi TUKETMEZ. TF yayinlamaz:
       tf_topic bilerek /tf'e bridge edilmeyen ayri bir isimde tutulur,
       boylece odom->base_footprint'in tek sahibi EKF olarak kalir. -->
  <gazebo>
    <plugin filename="libignition-gazebo6-odometry-publisher-system.so"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>ground_truth_odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/model/mecanum_robot/odometry</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>3</dimensions>
      <tf_topic>/model/mecanum_robot/ground_truth_tf_unused</tf_topic>
    </plugin>
  </gazebo>

  <!-- Lidar sensörü (Gazebo) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>5.5</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>1450</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- IMU sensoru (Gazebo) — gercekte BNO055 driver'i imu/data_raw uretir -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu/data_raw</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
